.claude/settings.local.json

# Env / secrets
.env
*.key
.secrets/
alphavantage*.txt
*.env.local

# Alpha Vantage raw slice cache — D191: cache the raw, commit the derived
data/raw/alphavantage/

# Smoke-test artifacts: never tracked. A smoke page sitting next to a real
# results page is exactly what gets misread as a result later.
*.smoke.*

# Exchange-licensed data: cache locally, never commit (see docs/research/futures-data/00-SYNTHESIS.md)
data/raw/databento/
data/raw/futures/
data/raw/ibkr/
data/fixtures/*futures*
data/fixtures/*glbx*

# temp/ is disposable by contract -- see temp/README.md. Only the README is tracked.
/temp/*
!/temp/README.md

# D361 trade export: the plain CSV is regenerated by scripts/d361_export_trades.py or gunzip; the .gz is tracked
data/d361_trades_gap_up_fade.csv

# Third-party YouTube transcripts: source material read for review, never evidence.
# Anything worth keeping is quoted into docs/youtube-lessons.md or a decision record.
# The raw transcripts are disposable and are not ours to redistribute.
docs/Youtube Transcrips/

# D377 ensemble: 136 MB of reconstructed book series, 4x the largest tracked file.
# Exactly reproducible: `uv run python scripts/run_d377_hedge.py --build --draws 500` (~10 min, deterministic seeds).
# Every number the record quotes lives in the committed data/d377_hedge.json.
data/d377_ensemble.npz
