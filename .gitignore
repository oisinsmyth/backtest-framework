# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Testing / tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Data — snapshots and trial registry are local artifacts, not source (D24, D20)
/data/snapshots/
/data/raw/
*.sqlite
*.sqlite3
trial_registry.csv

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code local settings (machine-specific)
.claude/settings.local.json

# Env / secrets
.env
*.key
.secrets/
alphavantage*.txt
*.env.local

# Alpha Vantage raw slice cache — D191: cache the raw, commit the derived
data/raw/alphavantage/

# Smoke-test artifacts: never tracked. A smoke page sitting next to a real
# results page is exactly what gets misread as a result later.
*.smoke.*

# Exchange-licensed data: cache locally, never commit (see docs/research/futures-data/00-SYNTHESIS.md)
data/raw/databento/
data/raw/futures/
data/fixtures/*futures*
data/fixtures/*glbx*

# temp/ is disposable by contract -- see temp/README.md. Only the README is tracked.
/temp/*
!/temp/README.md
